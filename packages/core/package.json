{
  "name": "@gamedevland/cyber-ui",
  "version": "0.2.0",
  "description": "Host-driven procedural cyberpunk UI and animation primitives for PixiJS 8",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "pixi.js": ">=8.16.0 <9"
  },
  "author": "Gamedev Land",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamedevland/cyber-ui-toolkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gamedevland/cyber-ui-toolkit#readme",
  "bugs": {
    "url": "https://github.com/gamedevland/cyber-ui-toolkit/issues"
  },
  "keywords": [
    "pixijs",
    "cyberpunk",
    "ui",
    "gamedev",
    "typescript"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
